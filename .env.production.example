# Django
DJANGO_SECRET_KEY=prod-secret-change-this-to-a-secure-random-key-nepse-platform
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=132.226.211.176,meguro.com.np,www.meguro.com.np,localhost,127.0.0.1
DEBUG=false

# Origins allowed to call the API from a browser.
# Add the production Vercel domain (and any custom frontend domain).
CORS_ALLOWED_ORIGINS=https://meguro.com.np,https://www.meguro.com.np,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://meguro.com.np,https://www.meguro.com.np,https://your-frontend.vercel.app

# PostgreSQL (internal docker service)
POSTGRES_DB=nepse_platform
POSTGRES_USER=nepse
POSTGRES_PASSWORD=nepse_secure_pass_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery (internal docker service)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# NEPSE API
NEPSE_API_BASE_URL=https://www.nepalstock.com
NEPSE_SSL_VERIFY=true
NEPSE_TIMEOUT=30
NEPSE_MAX_RETRIES=3
NEPSE_BACKOFF_FACTOR=1.0

# Security settings for HTTP (set to true if SSL/HTTPS is added later)
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# If the frontend is hosted on a different site (e.g. Vercel) and uses
# credentialed requests, cookies must be cross-site:
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SAMESITE=None
