# Django
DJANGO_SECRET_KEY=prod-secret-change-this-to-a-secure-random-key-nepse-platform
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=132.226.211.176,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://132.226.211.176
DEBUG=false

# PostgreSQL (internal docker service)
POSTGRES_DB=nepse_platform
POSTGRES_USER=nepse
POSTGRES_PASSWORD=nepse_secure_pass_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery (internal docker service)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# NEPSE API
NEPSE_API_BASE_URL=https://www.nepalstock.com
NEPSE_SSL_VERIFY=true
NEPSE_TIMEOUT=30
NEPSE_MAX_RETRIES=3
NEPSE_BACKOFF_FACTOR=1.0

# Security settings for HTTP (set to true if SSL/HTTPS is added later)
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
